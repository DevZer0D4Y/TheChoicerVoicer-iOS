diff --git a/platform/ios/display_server_ios.mm b/platform/ios/display_server_ios.mm
index 09acc19..7452da3 100644
--- a/platform/ios/display_server_ios.mm
+++ b/platform/ios/display_server_ios.mm
@@ -282,6 +282,22 @@ void DisplayServerIOS::touch_press(int p_idx, int p_x, int p_y, bool p_pressed,
 	ev->set_position(Vector2(p_x, p_y));
 	ev->set_double_tap(p_double_click);
 	perform_event(ev);
+
+	// Desktop games often rely on right-click; a second finger acts as the right mouse button.
+	static bool right_button_down = false;
+	if (p_idx == 1 && p_pressed != right_button_down) {
+		right_button_down = p_pressed;
+		Ref<InputEventMouseButton> mb;
+		mb.instantiate();
+		mb->set_button_index(MouseButton::RIGHT);
+		mb->set_pressed(p_pressed);
+		mb->set_button_mask(p_pressed ? MouseButtonMask::RIGHT : BitField<MouseButtonMask>());
+		if (p_x >= 0) { // Canceled touches report (-1, -1).
+			mb->set_position(Vector2(p_x, p_y));
+			mb->set_global_position(Vector2(p_x, p_y));
+		}
+		perform_event(mb);
+	}
 }
 
